# Next.js local dev. Copy to apps/web/.env.local

# Clerk — grab keys with `clerk env pull` (dev) or from dashboard.clerk.com.
# Use pk_live/sk_live values in production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/now
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/now

# Who may sign in (comma-separated). Enforced by the API and the goals BFF.
ALLOWED_EMAILS=you@gmail.com

# Direct DB access for the goals BFF + first-login user bootstrap.
DATABASE_URL=postgresql://devplanner:devplanner@localhost:5433/devplanner

NEXT_PUBLIC_API_URL=http://localhost:3001
