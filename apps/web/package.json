{
  "name": "@devplanner/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "cross-env WATCHPACK_POLLING=1 CHOKIDAR_USEPOLLING=1 NEXT_TELEMETRY_DISABLED=1 next dev --webpack -p 3000 -H 0.0.0.0",
    "dev:webpack": "cross-env WATCHPACK_POLLING=1 CHOKIDAR_USEPOLLING=1 NEXT_TELEMETRY_DISABLED=1 next dev --webpack -p 3000 -H 0.0.0.0",
    "dev:turbo": "cross-env NEXT_TELEMETRY_DISABLED=1 next dev -p 3000 -H 0.0.0.0 --turbo",
    "dev:diag": "node -e \"console.log('node',process.version,'cwd',process.cwd())\" && npx next info",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "test:coverage": "jest --config jest.coverage.config.js --runInBand"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.39.5",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.62.8",
    "@types/canvas-confetti": "^1.6.4",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "0.45.3",
    "lucide-react": "^0.468.0",
    "next": "16.3.7",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.16",
    "ts-jest": "^29.1.2",
    "typescript": "^5.7.2",
    "@testing-library/dom": "^10.4.1"
  }
}
